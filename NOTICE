The following files are copied from Ente's Go CLI, taken from repository HEAD
f3488d3ace21b523d93dacc19ad21c6d14db9586 (2026-09-16):

  internal/crypto/crypto.go         <- cli/internal/crypto/crypto.go
  internal/crypto/crypto_native.go  <- cli/internal/crypto/crypto_native.go
  internal/crypto/stream.go         <- cli/internal/crypto/stream.go
  internal/crypto/utils.go          <- cli/internal/crypto/utils.go
  internal/crypto/crypto_test.go    <- cli/internal/crypto/crypto_test.go
